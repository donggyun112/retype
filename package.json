{
  "name": "retype",
  "displayName": "retype",
  "description": "AI가 코드를 적용하는 대신 불러준다. 사람이 직접 친다.",
  "version": "0.1.0",
  "publisher": "dongkseo",
  "repository": { "type": "git", "url": "https://github.com/donggyun112/retype" },
  "private": true,
  "engines": {
    "vscode": "^1.101.0"
  },
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "categories": [
    "AI",
    "Education"
  ],
  "contributes": {
    "mcpServerDefinitionProviders": [
      {
        "id": "retype",
        "label": "retype"
      }
    ],
    "commands": [
      {
        "command": "retype.ask",
        "title": "retype: 여기서 claude에게 묻기"
      },
      {
        "command": "retype.submit",
        "title": "claude에게",
        "enablement": "!commentIsEmpty"
      },
      {
        "command": "retype.close",
        "title": "닫기",
        "icon": "$(close)"
      },
      {
        "command": "retype.askViewport",
        "title": "retype: 이 구간 물어보기"
      },
      {
        "command": "retype.cancel",
        "title": "retype: 따라쓰기 취소"
      }
    ],
    "menus": {
      "commandPalette": [
        { "command": "retype.submit", "when": "false" },
        { "command": "retype.close", "when": "false" }
      ],
      "comments/commentThread/context": [
        { "command": "retype.submit", "group": "inline", "when": "commentController == retype" }
      ],
      "comments/commentThread/title": [
        { "command": "retype.close", "group": "inline", "when": "commentController == retype" }
      ]
    },
    "keybindings": [
      {
        "command": "retype.ask",
        "key": "ctrl+k i",
        "mac": "cmd+k i",
        "when": "editorTextFocus"
      },
      {
        "command": "retype.askViewport",
        "key": "cmd+k q",
        "mac": "cmd+k q",
        "win": "ctrl+k q",
        "linux": "ctrl+k q"
      },
      {
        "command": "retype.cancel",
        "key": "escape",
        "when": "editorTextFocus && retype.active"
      },
      {
        "command": "tab",
        "key": "tab",
        "when": "editorTextFocus && retype.active && inlineSuggestionVisible && !suggestWidgetVisible && !editorTabMovesFocus"
      },
      {
        "command": "cursorEnd",
        "key": "cmd+right",
        "mac": "cmd+right",
        "when": "editorTextFocus && retype.active && inlineSuggestionVisible"
      },
      {
        "command": "cursorWordEndRight",
        "key": "ctrl+right",
        "win": "ctrl+right",
        "linux": "ctrl+right",
        "when": "editorTextFocus && retype.active && inlineSuggestionVisible"
      }
    ],
    "configuration": {
      "title": "retype",
      "properties": {
        "retype.agent": {
          "type": "string",
          "enum": ["claude", "codex"],
          "default": "claude",
          "description": "Cmd+K I가 부를 에이전트. claude = Claude Code, codex = OpenAI Codex CLI."
        },
        "retype.codexPath": {
          "type": "string",
          "default": "",
          "description": "codex CLI 경로. 비우면 OpenAI(Codex) 익스텐션에 든 바이너리 → PATH 순으로 찾는다."
        },
        "retype.claudePath": {
          "type": "string",
          "default": "",
          "description": "Cmd+K I로 띄울 claude CLI 경로. 비우면 Claude Code 익스텐션에 든 바이너리 → PATH 순으로 찾는다."
        },
        "retype.port": {
          "type": "number",
          "default": 41773,
          "description": "MCP 서버 포트. 0이면 랜덤. 창 밖 클라이언트(Claude Code 등)를 붙이려면 고정해야 한다."
        },
        "retype.timeoutMinutes": {
          "type": "number",
          "default": 10,
          "description": "따라쓰기 중 입력이 없을 때 포기할 때까지의 분."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p .",
    "package": "npx @vscode/vsce package --allow-missing-repository --skip-license --baseContentUrl file:. --baseImagesUrl file:.",
    "install:local": "npm run package && code --install-extension retype-0.1.0.vsix --force",
    "watch": "tsc -p . -w",
    "test": "tsc -p . && node out/match.test.js",
    "test:e2e": "tsc -p . && node out/e2e/runTests.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.101.0",
    "@vscode/test-electron": "^3.1.0",
    "typescript": "^5.6.0"
  }
}
